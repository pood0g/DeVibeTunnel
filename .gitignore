# Maven build output (classes, jars including the -cli jar, test and checkstyle reports)
target/

# Generated by flatten-maven-plugin (resolves ${revision} in the pom)
.flattened-pom.xml

# Generated by maven-shade-plugin when createDependencyReducedPom is enabled
dependency-reduced-pom.xml

# Maven release plugin
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Maven build timing and local settings
buildNumber.properties
.mvn/timing.properties
.mvn/maven.config.local

# Maven wrapper: keep the wrapper scripts and properties, but not the downloaded jar
.mvn/wrapper/maven-wrapper.jar

# Compiled classes and archives outside target/
*.class
*.jar
*.war
*.ear

# JVM crash logs and surefire dump files
hs_err_pid*
replay_pid*
*.dump
*.dumpstream

# IDE files generated from the Maven project (.vscode/ is tracked and not ignored)
.classpath
.project
.settings/
.factorypath
.idea/
*.iml
